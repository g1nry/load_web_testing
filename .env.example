# Copy this file to .env and set the authorized target before running tests.
TARGET_URL=https://example.internal

REQUEST_TIMEOUT=5s
SLEEP_SECONDS=1
LOAD_ENDPOINTS=/
GRAFANA_DASHBOARD_URL=

# Used by scripts/run-suite.sh. Keep high-impact profiles out by default.
TEST_PROFILES=smoke,discovery,baseline
ALLOW_HIGH_IMPACT_TESTS=false

SMOKE_VUS=1
SMOKE_DURATION=30s

DISCOVERY_VUS=1
DISCOVERY_DURATION=10s

BASELINE_VUS=10
BASELINE_DURATION=3m

LOAD_VUS=30
LOAD_DURATION=5m

STRESS_STAGE_1_VUS=10
STRESS_STAGE_1_DURATION=2m
STRESS_STAGE_2_VUS=50
STRESS_STAGE_2_DURATION=3m
STRESS_STAGE_3_VUS=100
STRESS_STAGE_3_DURATION=3m
STRESS_RAMP_DOWN_DURATION=2m

SPIKE_LOW_VUS=10
SPIKE_HIGH_VUS=100
SPIKE_LOW_DURATION=1m
SPIKE_HIGH_DURATION=1m
SPIKE_RECOVERY_DURATION=2m

ENDURANCE_VUS=20
ENDURANCE_DURATION=30m

# Controlled breakpoint search. Run only in an approved testing window.
CAPACITY_STEP_VUS=5,10,20,40,60,80,100
CAPACITY_RAMP_DURATION=30s
CAPACITY_HOLD_DURATION=1m
CAPACITY_RAMP_DOWN_DURATION=1m

# Copy this file to .env and set the authorized target before running tests.
TARGET_URL=https://example.internal

REQUEST_TIMEOUT=5s
SLEEP_SECONDS=1
LOAD_ENDPOINTS=/
ENABLE_CACHE_BUSTER=false
ENDPOINT_AUDIT_RETRIES=1
GRAFANA_DASHBOARD_URL=

# Optional direct Prometheus export into Markdown reports.
PROMETHEUS_URL=
PROMETHEUS_INSTANCE=
PROMETHEUS_NET_DEVICE=
PROMETHEUS_QUERY_STEP=30s
PROMETHEUS_QUERY_TIMEOUT=10
PROMETHEUS_APP_JOB=
PROMETHEUS_APP_INSTANCE=
PROMETHEUS_KUBE_NAMESPACE=
PROMETHEUS_KUBE_POD=
PROMETHEUS_KUBE_CONTAINER=

# Used by scripts/run-suite.sh. High-impact profiles are skipped by default.
TEST_PROFILES=smoke,discovery
ALLOW_HIGH_IMPACT_TESTS=false

SMOKE_VUS=1
SMOKE_DURATION=30s

DISCOVERY_VUS=1
DISCOVERY_DURATION=10s

# RPS-oriented throughput profile.
THROUGHPUT_ENDPOINTS=/
THROUGHPUT_RATE_STEPS=50,100,200,400
THROUGHPUT_RAMP_DURATION=30s
THROUGHPUT_HOLD_DURATION=1m
THROUGHPUT_RAMP_DOWN_DURATION=30s
THROUGHPUT_PRE_ALLOCATED_VUS=50
THROUGHPUT_MAX_VUS=500

# CPU pressure profile. /metrics can be used only when it is approved as CPU-heavy for this service.
CPU_ENDPOINTS=/metrics
CPU_RATE_STEPS=25,50,100,200
CPU_RAMP_DURATION=30s
CPU_HOLD_DURATION=1m
CPU_RAMP_DOWN_DURATION=30s
CPU_PRE_ALLOCATED_VUS=100
CPU_MAX_VUS=1000
CPU_NO_CONNECTION_REUSE=false

# Memory/concurrency pressure profile. /delay/{n} keeps requests open and can increase RAM pressure.
MEMORY_ENDPOINTS=/delay/30
MEMORY_VUS=300
MEMORY_DURATION=10m
MEMORY_REQUEST_TIMEOUT=45s
MEMORY_SLEEP_SECONDS=0
MEMORY_MIN_RESPONSE_BYTES=0

# Network pressure profile. /api/echo should echo the request body back.
NETWORK_ENDPOINTS=/api/echo
NETWORK_METHOD=POST
NETWORK_PAYLOAD_BYTES=65536
NETWORK_CONTENT_TYPE=text/plain
NETWORK_RATE=200
NETWORK_DURATION=5m
NETWORK_PRE_ALLOCATED_VUS=100
NETWORK_MAX_VUS=1000
NETWORK_REQUEST_TIMEOUT=15s
NETWORK_MIN_RESPONSE_BYTES=10240

# Controlled breakpoint search. Run only in an approved testing window.
CAPACITY_ENDPOINTS=/
CAPACITY_RATE_STEPS=50,100,200,400,800
CAPACITY_STEP_DURATION=1m
CAPACITY_GRACEFUL_STOP=30s
CAPACITY_FAILURE_RATE_LIMIT=0.05
CAPACITY_P95_LIMIT_MS=1000
CAPACITY_PRE_ALLOCATED_VUS=100
CAPACITY_MAX_VUS=2000

# Cumulative k6 abort thresholds for pressure profiles.
STOP_FAILURE_RATE=0.10
STOP_P95_MS=2000
STOP_DELAY=30s
REPORT_INTERVAL_SECONDS=10

# Independent GET probe: headers only, no redirects; at most one request every 5s.
# Runner OS resource samples are available on Linux via /proc.
ENABLE_DIAGNOSTIC_PROBE=true
DIAGNOSTIC_PROBE_ENDPOINT=/
DIAGNOSTIC_PROBE_INTERVAL_SECONDS=5
DIAGNOSTIC_PROBE_TIMEOUT_SECONDS=3
DIAGNOSTIC_PROBE_LIMIT_MS=2000
RECOVERY_OBSERVATION_SECONDS=60
RECOVERY_HEALTHY_SAMPLES=3

# Local build benchmark: loopback / private IP only; TARGET_URL is not used.
BENCHMARK_TARGET_URL=http://127.0.0.1:8080
BENCHMARK_ENDPOINTS=/
BENCHMARK_START_RATE=10
BENCHMARK_RATE_STEPS=50,100,200,400,600
BENCHMARK_WARMUP_DURATION=20s
BENCHMARK_RAMP_DURATION=20s
BENCHMARK_HOLD_DURATION=2m
BENCHMARK_SOAK_DURATION=5m
BENCHMARK_RAMP_DOWN_DURATION=30s
BENCHMARK_PRE_ALLOCATED_VUS=50
BENCHMARK_MAX_VUS=500
BENCHMARK_REQUEST_TIMEOUT=5s
BENCHMARK_GRACEFUL_STOP=30s

# Operator-supplied labels, not resource limits applied by the runner.
BENCHMARK_RUN_LABEL=baseline
BENCHMARK_SERVER_CPU=
BENCHMARK_SERVER_MEMORY=
BENCHMARK_SERVER_CONFIG=
BENCHMARK_GENERATOR_LOCATION=separate-host
